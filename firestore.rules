rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Chủ dự án (Google) luôn là Admin, không cần hồ sơ trong ild_sensory_users.
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'binhdangthanh94@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/ild_sensory_users/$(request.auth.uid);
    }

    function activeProfile() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    // Vai trò: user · qc · supervisor (Giám sát nếm) · admin.
    function isMember() { return isOwner() || activeProfile(); }
    function isAdmin()  { return isOwner() || (activeProfile() && get(profilePath()).data.role == 'admin'); }

    // Ma trận phân quyền do Admin tích chọn trong app: ild_sensory_v2/permissions.matrix[role][quyền] = true/false.
    function permPath() {
      return /databases/$(database)/documents/ild_sensory_v2/permissions;
    }

    function can(perm) {
      return isAdmin()
        || (activeProfile() && exists(permPath())
            && get(permPath()).data.matrix[get(profilePath()).data.role][perm] == true);
    }

    // Các trường kỹ thuật do app đồng bộ tự ghi.
    function syncKeys() {
      return ['revision', 'updatedAt', 'updatedBy', 'clientId'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function setPath(setId) {
      return /databases/$(database)/documents/ild_sensory_sets/$(setId);
    }

    function setApproved(setId) {
      return exists(setPath(setId)) && ('approval' in get(setPath(setId)).data);
    }

    // Legacy snapshot: chỉ Admin (migration/rollback).
    match /ild_sensory/shared_state {
      allow read, write: if isAdmin();
    }

    // Ma trận phân quyền: mọi thành viên đọc; chỉ Admin sửa.
    match /ild_sensory_v2/permissions {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Dữ liệu chung (meta): thành viên đọc/ghi; đổi Master Data cần quyền editMaster.
    match /ild_sensory_v2/{documentId} {
      allow read: if isMember();
      allow create: if isMember() && documentId != 'permissions';
      allow update: if isMember() && documentId != 'permissions'
        && (!changedKeys().hasAny(['panellists', 'products', 'recipes', 'pos', 'batches', 'lots', 'itemCodes']) || can('editMaster'));
      allow delete: if isAdmin();
    }

    // Set nếm — theo ma trận: createSet, editSet, closeSet, confirmSet, deleteSet.
    // Mọi thành viên được cập nhật danh sách người đã nộp (attendees) khi nộp phiếu.
    match /ild_sensory_sets/{setId} {
      allow read: if isMember();
      allow create: if can('createSet');
      allow update: if isMember() && (
        changedKeys().hasOnly(syncKeys().concat(['attendees']))
        || (can('confirmSet') && changedKeys().hasOnly(syncKeys().concat(['approval', 'status'])))
        || (can('closeSet') && changedKeys().hasOnly(syncKeys().concat(['status'])) && !('approval' in resource.data))
        || (can('editSet') && !changedKeys().hasAny(['approval']) && (!('approval' in resource.data) || isAdmin()))
      );
      allow delete: if can('deleteSet');
    }

    // Phiếu nộp ({setId}__{panellistId}): thành viên nộp/nộp lại khi Set chưa xác nhận; sửa/xoá theo quyền editSubmission.
    match /ild_sensory_scores/{scoreId} {
      allow read: if isMember();
      allow create, update: if isMember() && (!setApproved(scoreId.split('__')[0]) || isAdmin());
      allow delete: if can('editSubmission');
    }

    // Hồ sơ & vai trò tài khoản: mỗi người đọc được hồ sơ của mình; chỉ Admin tạo/sửa/xoá.
    match /ild_sensory_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['user', 'qc', 'supervisor', 'admin']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
  }
}
