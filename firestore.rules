rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Chủ dự án (Google) luôn là Admin, không cần hồ sơ trong ild_sensory_users.
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'binhdangthanh94@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/ild_sensory_users/$(request.auth.uid);
    }

    function activeProfile() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    function hasRole(roles) {
      return isOwner() || (activeProfile() && get(profilePath()).data.role in roles);
    }

    // Vai trò: user (chấm nếm) · qc (tạo & sửa Set) · supervisor (Giám sát nếm: xác nhận kết quả) · admin.
    function isMember()     { return isOwner() || activeProfile(); }
    function isAdmin()      { return hasRole(['admin']); }
    function isQC()         { return hasRole(['qc', 'admin']); }
    function isSupervisor() { return hasRole(['supervisor', 'admin']); }

    // Các trường kỹ thuật do app đồng bộ tự ghi.
    function syncKeys() {
      return ['revision', 'updatedAt', 'updatedBy', 'clientId'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function setPath(setId) {
      return /databases/$(database)/documents/ild_sensory_sets/$(setId);
    }

    function setApproved(setId) {
      return exists(setPath(setId)) && ('approval' in get(setPath(setId)).data);
    }

    // Legacy snapshot: chỉ Admin (migration/rollback).
    match /ild_sensory/shared_state {
      allow read, write: if isAdmin();
    }

    // Dữ liệu chung (Master Data, Panellist, audit…): mọi thành viên được đọc/ghi.
    match /ild_sensory_v2/{documentId} {
      allow read, write: if isMember();
    }

    // Set nếm:
    // - QC/Admin tạo & sửa (Set đã được Giám sát xác nhận thì chỉ Admin sửa).
    // - Thành viên chỉ được cập nhật danh sách người đã nộp (attendees) khi nộp phiếu.
    // - Giám sát/Admin xác nhận hoặc huỷ xác nhận (approval, status).
    // - Chỉ Admin được xoá.
    match /ild_sensory_sets/{setId} {
      allow read: if isMember();
      allow create: if isQC();
      allow update: if isMember() && (
        changedKeys().hasOnly(syncKeys().concat(['attendees']))
        || (isSupervisor() && changedKeys().hasOnly(syncKeys().concat(['approval', 'status'])))
        || (isQC() && !changedKeys().hasAny(['approval']) && (!('approval' in resource.data) || isAdmin()))
      );
      allow delete: if isAdmin();
    }

    // Phiếu nộp ({setId}__{panellistId}): thành viên nộp/nộp lại khi Set chưa được xác nhận; chỉ Admin xoá.
    match /ild_sensory_scores/{scoreId} {
      allow read: if isMember();
      allow create, update: if isMember() && (!setApproved(scoreId.split('__')[0]) || isAdmin());
      allow delete: if isAdmin();
    }

    // Hồ sơ & vai trò tài khoản: mỗi người đọc được hồ sơ của mình; chỉ Admin tạo/sửa/xoá.
    match /ild_sensory_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['user', 'qc', 'supervisor', 'admin']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
  }
}
