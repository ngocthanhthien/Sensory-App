rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Chủ dự án (Google) luôn là Admin, không cần hồ sơ trong ild_sensory_users.
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'binhdangthanh94@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/ild_sensory_users/$(request.auth.uid);
    }

    function activeProfile() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    // User chung (mật khẩu cấp 1) và tài khoản riêng đang hoạt động.
    function isMember() {
      return isOwner() || activeProfile();
    }

    function isAdmin() {
      return isOwner() || (activeProfile() && get(profilePath()).data.role == 'admin');
    }

    // Legacy snapshot: chỉ Admin (migration/rollback).
    match /ild_sensory/shared_state {
      allow read, write: if isAdmin();
    }

    // Dữ liệu app v2: mọi thành viên được đọc/ghi.
    match /ild_sensory_v2/{documentId} {
      allow read, write: if isMember();
    }

    // Set & phiếu nộp: thành viên đọc/tạo/sửa; chỉ Admin được xoá.
    match /ild_sensory_sets/{setId} {
      allow read, create, update: if isMember();
      allow delete: if isAdmin();
    }

    match /ild_sensory_scores/{scoreId} {
      allow read, create, update: if isMember();
      allow delete: if isAdmin();
    }

    // Hồ sơ & vai trò tài khoản: mỗi người đọc được hồ sơ của mình; chỉ Admin tạo/sửa/xoá.
    match /ild_sensory_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['user', 'admin']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
  }
}
